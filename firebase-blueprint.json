{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Essential profile data for both roles",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["mahasiswa", "dosen"] },
        "status": { "type": "string", "enum": ["active", "pending"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Mahasiswa": {
      "title": "Mahasiswa Data",
      "description": "Academic data for student profile",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "nama": { "type": "string" },
        "nim": { "type": "string" },
        "alamat": { "type": "string" },
        "nomorTelepon": { "type": "string" },
        "kelas": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "nama", "nim", "email"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Collection of user roles and basic info"
    },
    "mahasiswas": {
      "schema": "Mahasiswa",
      "description": "Extended student academic data"
    }
  }
}
